# Firebase Web configuration. These identifiers are browser-visible; they are not Firebase Admin credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: only set this when using a named Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional: required only when browser push notifications are enabled.
VITE_FIREBASE_VAPID_KEY=""

# Never put Firebase Admin credentials, service-account JSON, OAuth client secrets,
# database passwords, or Gemini keys in a VITE_* variable.
